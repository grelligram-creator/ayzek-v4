# Copy this file to .env for local development. Never commit a real .env file.

# Required for server-side Gemini requests. AI Studio can inject this from its
# Secrets panel; other hosts should configure it in their secret manager.
GEMINI_API_KEY=""

# Firebase Admin credentials used by authenticated server endpoints. Use the
# complete service-account JSON on one line. Leave empty only for UI-only work.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# The externally reachable application URL. This is used for OAuth callback
# generation; do not set it to a temporary localtunnel address in production.
APP_URL="http://localhost:3000"

# Cloud Run and similar providers inject PORT automatically. Keep this local
# default for `npm run dev`; production should set NODE_ENV=production.
PORT="3000"
NODE_ENV="development"
