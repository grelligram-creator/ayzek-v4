# Copy this file to .env for local development. Never commit a real .env file.

# Required for server-side Gemini requests. AI Studio can inject this from its
# Secrets panel; other hosts should configure it in their secret manager.
GEMINI_API_KEY=""

# Firebase Admin credentials used by authenticated server endpoints. Use the
# complete service-account JSON on one line. Leave empty only for UI-only work.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Optional OAuth connections. Both client ID and client secret are required for
# their matching provider. OAuth stays visibly disabled when these are absent.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""

# Exactly 32 bytes, encoded as base64 (or 64 hex characters). Generate once,
# store only in the host secret manager, and do not rotate it without a token
# migration because it encrypts stored OAuth token responses.
OAUTH_TOKEN_ENCRYPTION_KEY=""

# Remote Web Push. VAPID_PUBLIC_KEY may be returned to signed-in browsers;
# VAPID_PRIVATE_KEY remains secret. VAPID_SUBJECT is a contact URI, for example
# mailto:security@example.com.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:security@example.com"

# The externally reachable application URL. This is used for OAuth callback
# generation; do not set it to a temporary localtunnel address in production.
APP_URL="http://localhost:3000"

# Cloud Run and similar providers inject PORT automatically. Keep this local
# default for `npm run dev`; production should set NODE_ENV=production.
PORT="3000"
NODE_ENV="development"
